# The variable names docker/certs/generate-certs.sh writes to docker/.env.
# This file is documentation only: it is not read, and must never hold real values.
# Run the script to create the real, git-ignored docker/.env with random passwords.
KAFKA_CA_PASSWORD=
KAFKA_BROKER_KEYSTORE_PASSWORD=
KAFKA_CLIENT_KEYSTORE_PASSWORD=
KAFKA_REGISTRY_KEYSTORE_PASSWORD=
KAFKA_TRUSTSTORE_PASSWORD=
KDC_MASTER_PASSWORD=
POSTGRES_PASSWORD=
